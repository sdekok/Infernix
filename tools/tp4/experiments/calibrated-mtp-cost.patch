@@ -0,0 +1,51 @@
+#pragma once
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+namespace infernix::models::qwen4_exp {
+// Program policy: measured end-to-end draft/verify/commit intervals on this host.
+// Each row count has its own model. Initial costs retain the established prior;
+// completed steady-state observations replace it, without synchronizing a GPU.
+class DraftCostModel {
+public:
+    struct Estimate { double milliseconds = 0; std::uint64_t samples = 0; };
+    void observe(int drafts, double milliseconds) {
+        if (drafts < 0 || drafts > 8 || !(milliseconds > 0) || !std::isfinite(milliseconds)) {
+            throw std::invalid_argument("invalid MTP round cost observation");
+        }
+        auto& e = costs_[drafts];
+        e.milliseconds = e.samples ? e.milliseconds * .8 + milliseconds * .2 : milliseconds;
+        ++e.samples;
+    }
+    double cost(int drafts, double prior_slope) const {
+        if (costs_[drafts].samples) { return costs_[drafts].milliseconds; }
+        double base = costs_[0].milliseconds;
+        if (!costs_[0].samples) {
+            base = 1;
+            for (int k = 1; k <= 8; ++k) {
+                if (costs_[k].samples) { base = costs_[k].milliseconds / (1 + prior_slope * k); break; }
+            }
+        }
+        return base * (1 + prior_slope * drafts);
+    }
+    int choose(std::span<const double> expected_tokens, double prior_slope, std::uint64_t round) const {
+        if (expected_tokens.empty() || expected_tokens.size() > 9) { throw std::invalid_argument("invalid MTP candidates"); }
+        const int count = expected_tokens.size();
+        // Warm each legal width, then probe one width periodically. This includes
+        // K=0: an expensive drafter must be able to learn plain decoding's cost.
+        if (round < std::uint64_t(count * 2)) { return round % count; }
+        if (round % 32 == 0) { return (round / 32) % count; }
+        int best = 0; double score = expected_tokens[0] / cost(0, prior_slope);
+        for (int k = 1; k < count; ++k) {
+            const double candidate = expected_tokens[k] / cost(k, prior_slope);
+            if (candidate > score) { score = candidate; best = k; }
+        }
+        return best;
+    }
+    const std::array<Estimate, 9>& estimates() const noexcept { return costs_; }
+private:
+    std::array<Estimate, 9> costs_{};
+};
+}
--- a/tests/test_draft_cost.cpp
+++ b/tests/test_draft_cost.cpp
@@ -0,0 +1,20 @@
+#include "models/qwen4_exp/program/draft_cost.h"
+#include <array>
+#include <stdexcept>
+using infernix::models::qwen4_exp::DraftCostModel;
+void require(bool pass) { if (!pass) { throw std::runtime_error("draft cost policy selection failed"); } }
+int main() {
+    DraftCostModel m;
+    const std::array<double,4> yield{1,1.8,2.4,2.8};
+    m.observe(0,10);m.observe(1,13);m.observe(2,15);m.observe(3,18);
+    require(m.choose(yield,.38,15)==2);
+    for (int k=1;k<=3;++k) for(int j=0;j<40;++j)m.observe(k,40);
+    require(m.choose(yield,.38,15)==0);
+    for (int k=1;k<=3;++k)for(int j=0;j<40;++j)m.observe(k,10+k);
+    require(m.choose(yield,.38,15)==3);
+    std::array<bool,4> visited{};for(unsigned r=0;r<8;++r)visited[m.choose(yield,.38,r)]=true;
+    for(bool x:visited)require(x);
+    visited={};for(unsigned r=32;r<=128;r+=32)visited[m.choose(yield,.38,r)]=true;
+    for(bool x:visited)require(x);
+    const std::array<double,4> rejection{1,1,1,1};require(m.choose(rejection,.38,15)==0);
+}
